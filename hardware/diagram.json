    [ "esp:26", "r3:2", "red", [ "h0" ] ],
    [ "r3:1", "led_red:A", "red", [ "h0" ] ],
    [ "led_red:C", "esp:GND.1", "black", [ "v0" ] ],
    [ "bz1:1", "esp:GND.2", "black", [ "v0" ] ],
    [ "bz1:2", "esp:25", "orange", [ "v0" ] ],
    [ "btn1:1.l", "esp:4", "cyan", [ "h0" ] ],
    [ "btn1:2.l", "esp:GND.2", "black", [ "h0" ] ]
